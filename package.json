{
  "name": "namaz-vakti-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop app for monthly iqamah schedule generation from TSV",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "schedules:combine-yearly": "node scripts/combine-schedules-to-yearly.mjs",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n-keys.mjs"
  },
  "dependencies": {
    "csv-parse": "^5.5.6",
    "i18next": "^25.8.7",
    "xlsx-populate": "^1.21.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-vite": "^3.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.namazvakti.desktop",
    "productName": "Namaz Vakti Desktop",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/icons/**/*",
      "package.json"
    ],
    "win": {
      "icon": "icons/app.ico"
    },
    "mac": {
      "icon": "icons/app.icns"
    },
    "linux": {
      "icon": "icons"
    }
  }
}
