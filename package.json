{
  "name": "namaz-vakti-desktop",
  "version": "1.0.7",
  "private": true,
  "description": "Electron desktop app for monthly iqamah schedule generation from TSV",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "node --test scripts/output-paths.test.mjs scripts/reveal-in-folder.test.mjs scripts/default-output-folder.test.mjs",
    "schedules:fetch-diyanet-2027": "node scripts/fetch-diyanet-year.mjs",
    "schedules:fetch-diyanet-built-in-2027": "node scripts/fetch-diyanet-built-in-year.mjs",
    "schedules:combine-yearly": "node scripts/combine-schedules-to-yearly.mjs",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n-keys.mjs",
    "dist:win": "npm run build && set CSC_IDENTITY_AUTO_DISCOVERY=false && npx electron-builder --win nsis",
    "dist:win:portable": "npm run build && set CSC_IDENTITY_AUTO_DISCOVERY=false && npx electron-builder --win portable",
    "dist:win:all": "npm run build && set CSC_IDENTITY_AUTO_DISCOVERY=false && npx electron-builder --win nsis portable",
    "dist:linux": "npm run build && npx electron-builder --linux AppImage"
  },
  "dependencies": {
    "csv-parse": "^5.5.6",
    "i18next": "^25.8.7",
    "xlsx-populate": "^1.21.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-vite": "^3.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.namazvakti.desktop",
    "productName": "Namaz Vakti Desktop",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/renderer/**/*",
      "assets/schedules/**/*",
      "assets/templates/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icons",
        "to": "build/icons"
      }
    ],
    "win": {
      "icon": "icons/app.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Namaz Vakti Desktop",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "tr_TR"
      ],
      "language": "1033"
    },
    "mac": {
      "icon": "icons/app.icns"
    },
    "linux": {
      "icon": "icons"
    }
  }
}
